{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wking53214/CNS/contracts/uai1/schema.json",
  "title": "UAI-1 message and receiver-document schemas",
  "description": "Structural rules for UAI-1 (docs/interop/UAI-1.md). JSON Schema checks SHAPE only. It cannot check the signature, the time window, the audience, a digest, that a number is within +/-(2^53-1) and integral on the wire (use the strict reader), duplicate keys (JSON Schema never sees them), or anything stateful such as replay. Those are in the specification and in conformance-suite.json. Validating against this schema is necessary and not sufficient.",
  "$defs": {
    "identity": {"type": "string", "pattern": "^uai:ed25519:[0-9a-f]{64}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "posint": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "names": {"type": "array", "items": {"$ref": "#/$defs/name"}, "uniqueItems": true},
    "subject": {"type": "object", "additionalProperties": false, "required": ["identity", "digest"],
                "properties": {"identity": {"type": "string", "minLength": 1}, "digest": {"type": "string", "minLength": 1}}},
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "kind", "id", "from", "to", "conversation", "in_reply_to", "issued_at", "expires_at", "body", "sig"],
      "properties": {
        "v": {"const": "uai/1"},
        "kind": {"enum": ["manifest", "endorsement", "request", "offer", "accept", "refuse", "decision", "revocation"]},
        "id": {"$ref": "#/$defs/hex32"},
        "from": {"$ref": "#/$defs/identity"},
        "to": {"oneOf": [{"$ref": "#/$defs/identity"}, {"const": ""}]},
        "conversation": {"$ref": "#/$defs/hex32"},
        "in_reply_to": {"oneOf": [{"$ref": "#/$defs/digest"}, {"const": ""}]},
        "issued_at": {"$ref": "#/$defs/ms"},
        "expires_at": {"oneOf": [{"$ref": "#/$defs/ms"}, {"type": "null"}]},
        "body": {"type": "object"},
        "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "summary", "accepts", "requires", "evidence", "max_ttl_ms"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "version": {"$ref": "#/$defs/posint"}, "summary": {"type": "string"},
                     "accepts": {"$ref": "#/$defs/names"}, "requires": {"$ref": "#/$defs/names"}, "evidence": {"$ref": "#/$defs/names"},
                     "max_ttl_ms": {"$ref": "#/$defs/posint"}}
    },
    "terms": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "version", "decider", "requester", "subject", "disclose", "evidence", "decision_ttl_ms"],
      "properties": {"capability": {"$ref": "#/$defs/name"}, "version": {"$ref": "#/$defs/posint"},
                     "decider": {"$ref": "#/$defs/identity"}, "requester": {"$ref": "#/$defs/identity"},
                     "subject": {"$ref": "#/$defs/subject"}, "disclose": {"$ref": "#/$defs/names"},
                     "evidence": {"$ref": "#/$defs/names"}, "decision_ttl_ms": {"$ref": "#/$defs/posint"}}
    },
    "body.manifest": {"type": "object", "additionalProperties": false,
                      "required": ["name", "implementation", "protocols", "capabilities", "endorsements"],
                      "properties": {"name": {"type": "string"}, "implementation": {"type": "string"},
                                     "protocols": {"type": "array", "items": {"const": "uai/1"}, "minItems": 1},
                                     "capabilities": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/capability"}},
                                     "endorsements": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/envelope"}}}},
    "body.endorsement": {"type": "object", "additionalProperties": false, "required": ["subject", "domain"],
                         "properties": {"subject": {"$ref": "#/$defs/identity"}, "domain": {"type": "string", "minLength": 1}}},
    "body.request": {"type": "object", "additionalProperties": false,
                     "required": ["capability", "version", "subject", "offer_fields", "require_evidence", "max_ttl_ms"],
                     "properties": {"capability": {"$ref": "#/$defs/name"}, "version": {"$ref": "#/$defs/posint"},
                                    "subject": {"$ref": "#/$defs/subject"}, "offer_fields": {"$ref": "#/$defs/names"},
                                    "require_evidence": {"$ref": "#/$defs/names"}, "max_ttl_ms": {"$ref": "#/$defs/posint"}}},
    "body.offer": {"type": "object", "additionalProperties": false, "required": ["terms"],
                   "properties": {"terms": {"$ref": "#/$defs/terms"}}},
    "body.accept": {"type": "object", "additionalProperties": false, "required": ["terms_digest", "disclosure"],
                    "properties": {"terms_digest": {"$ref": "#/$defs/digest"}, "disclosure": {"type": "object"}}},
    "body.refuse": {"type": "object", "additionalProperties": false, "required": ["code", "reasons"],
                    "properties": {"code": {"type": "string", "pattern": "^[a-z_]+$"},
                                   "reasons": {"type": "array", "items": {"type": "string"}}}},
    "body.decision": {"type": "object", "additionalProperties": false,
                      "required": ["verdict", "terms_digest", "subject", "reasons", "evidence", "cns_root"],
                      "properties": {"verdict": {"enum": ["pass", "retry", "terminal_breach"]},
                                     "terms_digest": {"$ref": "#/$defs/digest"}, "subject": {"$ref": "#/$defs/subject"},
                                     "reasons": {"type": "array", "items": {"type": "string"}},
                                     "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                                  "required": ["kind", "content", "digest"],
                                                  "properties": {"kind": {"$ref": "#/$defs/name"}, "content": {"type": "object"},
                                                                 "digest": {"$ref": "#/$defs/digest"}}}},
                                     "cns_root": {"type": "string"}}},
    "body.revocation": {"type": "object", "additionalProperties": false,
                        "required": ["subject", "action", "successor", "reason", "effective_at"],
                        "properties": {"subject": {"type": "string", "minLength": 1}, "action": {"enum": ["revoke", "rotate"]},
                                       "successor": {"oneOf": [{"$ref": "#/$defs/identity"}, {"const": ""}]},
                                       "reason": {"type": "string"}, "effective_at": {"$ref": "#/$defs/ms"}}},
    "approval": {"type": "object", "additionalProperties": false,
                 "required": ["approver", "decision_id", "action", "subject_digest", "expires_at", "sig"],
                 "properties": {"approver": {"$ref": "#/$defs/identity"}, "decision_id": {"$ref": "#/$defs/hex32"},
                                "action": {"type": "string", "minLength": 1}, "subject_digest": {"type": "string", "minLength": 1},
                                "expires_at": {"$ref": "#/$defs/ms"}, "sig": {"type": "string", "pattern": "^[0-9a-f]{128}$"}}},
    "grant": {"type": "object", "additionalProperties": false,
              "required": ["id", "capability", "version", "requester", "deciders", "actions"],
              "properties": {"id": {"type": "string", "minLength": 1}, "capability": {"type": "string", "minLength": 1},
                             "version": {"$ref": "#/$defs/posint"}, "requester": {"$ref": "#/$defs/identity"},
                             "deciders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
                             "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                             "disclose_max": {"type": "array", "items": {"type": "string"}},
                             "expires_at": {"$ref": "#/$defs/ms"},
                             "approvers": {"type": "array", "items": {"$ref": "#/$defs/identity"}},
                             "retain_ms": {"$ref": "#/$defs/ms"}}},
    "grants_file": {"type": "object", "additionalProperties": false, "required": ["grants"],
                    "properties": {"grants": {"type": "array", "items": {"$ref": "#/$defs/grant"}}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["decision", "terms", "accept_digest", "artifact"],
            "properties": {"decision": {"$ref": "#/$defs/envelope"}, "terms": {"$ref": "#/$defs/terms"},
                           "accept_digest": {"$ref": "#/$defs/digest"},
                           "artifact": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
                           "approval": {"$ref": "#/$defs/approval"}}}
  },
  "oneOf": [{"$ref": "#/$defs/envelope"}]
}
